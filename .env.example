# Port for the API (and the built site in production)
PORT=4000

# Long random string. Leave empty to disable /admin entirely.
ADMIN_TOKEN=

# Optional: where the SQLite file lives (default server/data/st-clothings.db)
# DB_PATH=/var/lib/st-clothings/store.db

# Optional: WhatsApp alert to the shop for every website order (WhatsApp Business Cloud API).
# Leave empty to turn off. See server/src/notify.ts and the README for setup.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_NOTIFY_TO=918056221231
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=en
